{
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.daonview.com"
                }
            ],
            "destination": "https://daonview.com/:path*",
            "permanent": true
        }
    ],
    "crons": [
        {
            "path": "/api/cron/generate-column",
            "schedule": "0 1 */2 * *"
        }
    ]
}